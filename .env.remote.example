# Remote development environment variables.
# Copy this file to .env.remote and adjust as needed.
# These are read by start-remote-services.ps1.

# Zrok2 share names (reserved for stable URLs).
# The URLs will be: https://<name>.shares.zrok.io
ZROK_API_NAME=hakwadag-api
ZROK_APP_NAME=hakwadag-app

# Local ports (defaults shown).
# BACKEND_PORT=5000
# FRONTEND_PORT=5173

# After running start-remote-services.ps1, the following are set automatically:
#   ZROK_FRONTEND_URL=https://<ZROK_APP_NAME>.shares.zrok.io
#   VITE_API_URL=https://<ZROK_API_NAME>.shares.zrok.io
