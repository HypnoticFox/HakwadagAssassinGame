# Remote development environment variables.
# Copy this file to .env.remote and adjust as needed.
# These are read by start-remote-services.ps1.

# Cloudflared tunnel name and hostnames.
# The URLs will be: https://<CLOUDFLARED_API_HOST> and https://<CLOUDFLARED_APP_HOST>
CLOUDFLARED_TUNNEL=hakwadag
CLOUDFLARED_API_HOST=hakwadag-api.jarnovos.com
CLOUDFLARED_APP_HOST=hakwadag-app.jarnovos.com

# Local ports (defaults shown).
# BACKEND_PORT=5000
# FRONTEND_PORT=5173

# After running start-remote-services.ps1, the following are set automatically:
#   CLOUDFLARED_FRONTEND_URL=https://<CLOUDFLARED_APP_HOST>
#   VITE_API_URL=https://<CLOUDFLARED_API_HOST>
